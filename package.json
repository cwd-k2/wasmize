{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @wasmize/showcase dev",
    "build": "pnpm -r build",
    "build:lib": "pnpm --filter wasmize build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --exclude '**/e2e/**' --exclude '**/.claude/**'",
    "test:coverage": "vitest run --exclude '**/e2e/**' --exclude '**/.claude/**' --coverage",
    "test:e2e": "playwright test",
    "bench": "vitest bench packages/showcase/bench/perf",
    "bench:report": "vitest run packages/showcase/bench/",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@typescript/native-preview": "^7.0.0-dev.20260219.1",
    "@vitest/coverage-v8": "^4.0.18",
    "oxfmt": "^0.34.0",
    "oxlint": "^1.49.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c"
}
